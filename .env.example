# Copy this file to ".env" and fill in your free Twelve Data API key.
# Get one at: https://twelvedata.com/pricing  (Basic / free plan)
TWELVE_DATA_API_KEY=TWELVE_DATA_API_KEY

# REQUIRED: Turso (libSQL) database. All state — portfolios, company names, the
# profile cache, the screener snapshot and the visitor log — lives here. The app
# no longer writes JSON files, because a serverless filesystem (Vercel) discards
# them. Create a database at https://turso.tech, then copy its URL and a token.
# These same two values must also be set in the Vercel project's env vars.
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Optional: change the port the server listens on (default 3000)
# PORT=3000

# Optional (for publishing): make the app READ-ONLY for the public. When set, the
# public sees a cached snapshot and can only sort / collapse groups / export; adding
# or removing tickers, Refresh, Refresh All and backtests require logging in with
# this password (a "🔒 Admin login" button appears). When UNSET (the default), the
# app is fully open — every action is available with no login (local development).
# Pick a strong value before deploying to a public URL.
# ADMIN_PASSWORD=change-me-to-something-strong

# Optional: populate the fundamental columns (market cap, forward P/E, PEG, quarterly
# earnings growth). These come from the /statistics endpoint, which requires a Twelve
# Data PRO plan or higher. On lower tiers it 403s for real tickers, so it's OFF by
# default. Enable only after upgrading to Pro+:
# ENABLE_FUNDAMENTALS=true
#
# (Sector, via /profile, works on standard paid plans and is always fetched.)

# Optional: populate the Analyst columns (consensus + average price target). These use
# /recommendations and /price_target, which require a Twelve Data ULTRA plan or higher
# (they 403 on Pro for real tickers). OFF by default; enable only on Ultra+:
# ENABLE_ANALYST=true
